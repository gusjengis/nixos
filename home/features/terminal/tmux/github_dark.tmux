set -g status-style "fg=#8b949e,bg=#0d1117"
set -g status-left-style "fg=#58a6ff,bg=#0d1117,bold"
set -g status-right-style "fg=#8b949e,bg=#0d1117"

set -g window-status-style "fg=#8b949e,bg=#0d1117"
set -g window-status-current-style "fg=#58a6ff,bg=#0d1117,bold"
set -g window-status-activity-style "fg=#e3b341,bg=#0d1117,bold"
set -g window-status-bell-style "fg=#ff7b72,bg=#0d1117,bold"

set -g pane-border-style "fg=#30363d"
set -g pane-active-border-style "fg=#58a6ff"

set -g message-style "fg=#c9d1d9,bg=#161b22"
set -g message-command-style "fg=#c9d1d9,bg=#161b22"
set -g mode-style "fg=#0d1117,bg=#58a6ff"

set -g clock-mode-colour "#58a6ff"
set -g copy-mode-match-style "fg=#0d1117,bg=#e3b341"
set -g copy-mode-current-match-style "fg=#0d1117,bg=#58a6ff"
