 void ToolkitDelegateViews::Init(ui::SimpleMenuModel* menu_model) {
+#if BUILDFLAG(IS_LINUX)
+  // The prebuilt MenuItemView constructor bypasses the platform menu-model
+  // factory. Use the same factory as browser-chrome context menus so the
+  // Quickshell runner receives page, link, image and editable-content menus.
+  // Website-drawn DOM menus do not reach this delegate.
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model,
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  return;
+#endif
   menu_adapter_ = std::make_unique<views::MenuModelAdapter>(menu_model);
