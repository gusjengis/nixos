diff --git a/ui/gfx/platform_font_skia.cc b/ui/gfx/platform_font_skia.cc
--- a/ui/gfx/platform_font_skia.cc
+++ b/ui/gfx/platform_font_skia.cc
@@ -205,3 +205,20 @@
+#if BUILDFLAG(IS_LINUX)
+  // CoreText selects the text optical master (opsz=17), not the public
+  // variable SF Pro font's default display master (opsz=28). This private
+  // family pins that axis while retaining regular/medium/bold/italic.
+  family = "Chromium UI SF Pro";
+  size_pixels = 13;
+  style = Font::NORMAL;
+  weight = Font::Weight::NORMAL;
+  // The settings above replaced GTK's face. Query this face's rendering
+  // settings too, rather than retaining rendering parameters for GTK's font.
+  FontRenderParamsQuery query;
+  query.families.push_back(family);
+  query.pixel_size = size_pixels;
+  query.weight = weight;
+  params = gfx::GetFontRenderParams(query, nullptr);
+#endif
+
   bool success = false;
   sk_sp<SkTypeface> typeface =
       CreateSkTypeface(style & Font::ITALIC, weight, &family, &success);
