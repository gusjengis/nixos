@@ -0,0 +1,25 @@
+#pragma once
+
+#include "../helpers/time/Time.hpp"
+#include "../desktop/DesktopTypes.hpp"
+
+namespace Render {
+    class IHyprRenderer;
+
+    using LayerRenderOriginalV1 = void (*)(IHyprRenderer*, PHLLS, PHLMONITOR, const Time::steady_tp&, bool, bool);
+    using LayerRenderCallbackV1 = void (*)(LayerRenderOriginalV1, IHyprRenderer*, PHLLS, PHLMONITOR, const Time::steady_tp&, bool, bool);
+    using RegisterLayerRenderV1 = bool (*)(void*, LayerRenderCallbackV1);
+    using UnregisterLayerRenderV1 = bool (*)(void*, LayerRenderCallbackV1);
+
+    // Compositor-owned cleanup also covers forced ejection without PLUGIN_EXIT.
+    void clearLayerRenderCallbackForOwner(void* owner);
+}
+
+// Private fork API: C symbol lookup, matching Hyprland C++ headers/ABI required.
+// Main thread only. The callback calls the continuation synchronously, exactly
+// once with the supplied arguments, and must not retain it or unload itself.
+// One owner at a time; unregister before unload, including failed plugin init.
+extern "C" {
+    __attribute__((visibility("default"))) bool hyprland_register_layer_render_v1(void* owner, Render::LayerRenderCallbackV1 callback);
+    __attribute__((visibility("default"))) bool hyprland_unregister_layer_render_v1(void* owner, Render::LayerRenderCallbackV1 callback);
+}
