+namespace {
+    void*                        layerRenderOwner = nullptr;
+    Render::LayerRenderCallbackV1 layerRenderCallback = nullptr;
+}
+
+extern "C" bool hyprland_register_layer_render_v1(void* owner, Render::LayerRenderCallbackV1 callback) {
+    if (!owner || !callback || layerRenderOwner)
+        return false;
+    layerRenderOwner    = owner;
+    layerRenderCallback = callback;
+    return true;
+}
+
+extern "C" bool hyprland_unregister_layer_render_v1(void* owner, Render::LayerRenderCallbackV1 callback) {
+    if (!owner || owner != layerRenderOwner || callback != layerRenderCallback)
+        return false;
+    layerRenderCallback = nullptr;
+    layerRenderOwner    = nullptr;
+    return true;
+}
+
+void Render::clearLayerRenderCallbackForOwner(void* owner) {
+    if (owner && owner == layerRenderOwner) {
+        layerRenderCallback = nullptr;
+        layerRenderOwner    = nullptr;
+    }
+}
+
 void IHyprRenderer::renderLayer(PHLLS pLayer, PHLMONITOR pMonitor, const Time::steady_tp& time, bool popups, bool lockscreen) {
+    const auto original = +[](IHyprRenderer* renderer, PHLLS layer, PHLMONITOR monitor, const Time::steady_tp& now, bool renderPopups, bool renderLockscreen) {
+        renderer->renderLayerOriginal(layer, monitor, now, renderPopups, renderLockscreen);
+    };
+    if (layerRenderCallback) {
+        layerRenderCallback(original, this, pLayer, pMonitor, time, popups, lockscreen);
+        return;
+    }
+    original(this, pLayer, pMonitor, time, popups, lockscreen);
+}
