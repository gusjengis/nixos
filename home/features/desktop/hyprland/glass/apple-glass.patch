index 0000000..c91a7fd
--- /dev/null
+++ b/src/AppleGlass.hpp
@@ -0,0 +1,161 @@
+#pragma once
+
+// Port of QuartzCore's glass_background shader (macOS 27, see the MacOS Theme
+// session's 23-sidebar-glass/shaders/DECOMPILED.md) with the numpy model's
+// unit conventions (23-sidebar-glass/model/glass.py):
+//   - all lengths are logical points; the renderer multiplies by monitor scale;
+//   - the backdrop is a mip chain whose level 0 is 4 pt per texel, blur radii
+//     select a level with Apple's blur_lod(r);
+//   - colour maths runs on sRGB-encoded values.
+// Presets are the Apple filter inputs converted to these units (or fitted).
+
+#include <GLES3/gl32.h>
+#include <hyprland/src/desktop/DesktopTypes.hpp>
+#include <hyprland/src/protocols/core/Compositor.hpp>
+#include <hyprland/src/render/Framebuffer.hpp>
+#include <hyprutils/math/Box.hpp>
+
+#include <hyprland/src/render/pass/PassElement.hpp>
+
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace AppleGlass {
+
+using Row = std::array<float, 4>; // rgb weights + offset
+using ColorMatrix = std::array<Row, 3>;
+
+inline constexpr ColorMatrix IDENTITY_CM = {Row{1, 0, 0, 0}, Row{0, 1, 0, 0}, Row{0, 0, 1, 0}};
+
+struct SParams {
+    // Backdrop margin sampled around the glass box (Apple's marginWidth).
+    float margin = 77.0f;
+    // Extra quad padding around the shape (shadow/ring/highlight reach).
+    float quadPad = 0.0f;
+
+    // Displacement: unit SDF normal scaled per axis (stands in for displacement_mat).
+    std::array<float, 2> dispScale{1.0f, 1.0f};
