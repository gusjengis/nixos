+
+    // (5) face over shadow, then ring
+    vec4 o = mix(shadowCol, face, cov);
+    o = o * (1.0 - ring) + vec4(0.0, 0.0, 0.0, ring);
+
+    // (6) highlight
+    if (highlight > 1e-6) {
