+    // ── AppleGlass (AppleGlass.hpp) ────────────────────────────────────────
+    // Copies the backdrop under the glass into a mipmappable texture, encoded
+    // sRGB, with the owning window's body painted in where configured.
+    {"applecopy.frag", R"GLSL(
+#version 300 es
+precision highp float;
+
+uniform sampler2D tex;        // current framebuffer
+uniform vec2 srcSize;         // framebuffer size, px
+uniform vec2 dstOrigin;       // framebuffer px of our level-0 texel (0,0)
+uniform int bodyFill;
+uniform vec4 bodyRect;        // framebuffer px
+uniform float bodyRadius;
+uniform vec3 bodyColor;       // encoded sRGB
+uniform int workLinear;
+uniform float workBlack;
+uniform float workWhite;
+uniform int sdrGamma22;
+
+in vec2 v_texcoord;
+layout(location = 0) out vec4 fragColor;
+
+vec3 toSrgb(vec3 c) {
+    if (workLinear == 0) return c;
+    vec3 v = clamp((c - workBlack) / max(workWhite - workBlack, 1e-6), 0.0, 1.0);
+    if (sdrGamma22 == 1) return pow(v, vec3(1.0 / 2.2));
+    return mix(1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, v * 12.92, lessThanEqual(v, vec3(0.0031308)));
+}
+
+void main() {
+    vec2 p = dstOrigin + gl_FragCoord.xy;
+    vec4 c = texture(tex, p / srcSize);
+    vec3 rgb = toSrgb(c.rgb / max(c.a, 1e-6));
+    if (c.a < 1e-6) rgb = vec3(0.0);
+    if (bodyFill == 1) {
+        vec2 h = bodyRect.zw * 0.5;
+        vec2 q = abs(p - bodyRect.xy - h) - h + bodyRadius;
+        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - bodyRadius;
+        rgb = mix(rgb, bodyColor, clamp(0.5 - d, 0.0, 1.0));
+    }
+    fragColor = vec4(rgb, 1.0);
+}
+)GLSL"},
