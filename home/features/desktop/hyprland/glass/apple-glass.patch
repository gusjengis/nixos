+float blurLod(float r) { return max(0.0, log2(r < 2.0 ? r * 0.5 + 1.0 : r)); }
+float circ(float t) { t = clamp(t, 0.0, 1.0); return clamp(sqrt((2.0 - t) * t), 0.0, 1.0); }
+float erfcHalf(float v) {
