+vec3 sdg(vec2 fp) {
+    vec2 h = shapeRect.zw * 0.5;
+    vec2 p = fp - shapeRect.xy - h;
+    float r = p.x > 0.0 ? (p.y > 0.0 ? radii.z : radii.y) : (p.y > 0.0 ? radii.w : radii.x);
+    r = min(r, min(h.x, h.y));
+    vec2 w = abs(p) - (h - r);
+    vec2 s = vec2(p.x < 0.0 ? -1.0 : 1.0, p.y < 0.0 ? -1.0 : 1.0);
+    float g = max(w.x, w.y);
+    vec2 q = max(w, 0.0);
+    float l = length(q);
+    vec2 n = s * (g > 0.0 ? q / max(l, 1e-6) : (w.x > w.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0)));
