+};
+
+// Built-in presets by item preset name; nullptr when unknown.
+[[nodiscard]] const SParams* preset(std::string_view name);
+
+// One glassed region on a window's main surface (hyprglass_item_v1 hints on the
+// toplevel surface). Holds the cached mipmapped backdrop.
+class CState {
+  public:
+    ~CState();
+
+    // Draws glass into currentFB before the owning surface draws over it.
+    // All boxes are monitor-local framebuffer pixels (post-transform).
+    // resample=false (snapshots, screencopy replays) draws from the cached backdrop only.
+    void draw(PHLMONITOR monitor, const SParams& params, const CBox& glassBox, const std::array<float, 4>& radii,
+              const std::optional<CBox>& windowBox, float windowRadius, float alpha, bool resample);
+
+  private:
+    GLuint m_tex = 0, m_fbo = 0;
+    int    m_w = 0, m_h = 0, m_levels = 0;
+    CBox   m_texBox;           // framebuffer px covered by level 0
+    CBox   m_lastGlassBox;
+    bool   m_valid = false;
+    uint64_t m_lastGeneration = 0;
+
+    bool ensureTexture(int w, int h);
+    void sample(PHLMONITOR monitor, const SParams& params, const std::optional<CBox>& windowBox, float windowRadius);
+};
+
+// How far around the glass box the effect reads or draws, in points.
+[[nodiscard]] float reachPoints(const SParams& params);
+
+// Per-surface state registry (weakly keyed; pruned once per frame).
+[[nodiscard]] std::shared_ptr<CState> stateFor(const WP<CWLSurfaceResource>& surface);
+void                                  pruneStates();
+void                                  clearStates();
+
+// Pre-surface element: draws the glass under a window's main surface.
+class CPassElement : public IPassElement {
+  public:
+    struct SData {
+        std::shared_ptr<CState> state;
+        const SParams*          params = nullptr;
+        PHLMONITORREF           monitor;
+        CBox                    glassBox;      // framebuffer px
+        std::array<float, 4>    radii{};       // px
+        std::optional<CBox>     windowBox;     // framebuffer px
+        float                   windowRadius = 0.0f;
+        float                   alpha        = 1.0f;
+        bool                    resample     = true;
+        CBox                    logicalBounds; // monitor-local logical, padded by reach
+    };
+
+    explicit CPassElement(SData data) : m_data(std::move(data)) {}
+    ~CPassElement() override = default;
+
+    std::vector<UP<IPassElement>> draw() override;
+    [[nodiscard]] bool                needsLiveBlur() override { return true; }
+    [[nodiscard]] bool                needsPrecomputeBlur() override { return false; }
+    [[nodiscard]] std::optional<CBox> boundingBox() override { return m_data.logicalBounds; }
+    [[nodiscard]] bool                disableSimplification() override { return true; }
+    [[nodiscard]] const char*         passName() override { return "CAppleGlassPassElement"; }
+    [[nodiscard]] ePassElementType    type() override { return EK_CUSTOM; }
+
+  private:
+    SData m_data;
+};
+
