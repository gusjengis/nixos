+    // glass_background<C,R,E> (QuartzCore, macOS 27), see AppleGlass.hpp for units.
+    {"appleglass.frag", R"GLSL(
+#version 300 es
+precision highp float;
+
+uniform sampler2D tex;        // backdrop mip chain, encoded sRGB, level 0 = 1 framebuffer px
+uniform vec2 texOrigin;       // framebuffer px of texel (0,0)
+uniform vec2 texSize;         // level-0 size
+uniform float lodBias;        // log2(4 * scale): Apple's backdrop is 1/4 scale
+uniform float px;             // monitor scale, px per pt
+uniform vec4 shapeRect;       // framebuffer px
+uniform vec4 radii;           // px; -y corners first: (x-,y-) (x+,y-) (x+,y+) (x-,y+)
+uniform float opacity;
+
+uniform vec2 dispScale;
+uniform int refraction;
+uniform float innerRefrAmount, innerRefrInvH, outerRefrAmount, outerRefrInvH;
+uniform float refrThr0, refrThr1, refrOpacity;
+uniform float blurRadius;
+uniform vec4 blurAlpha;
+uniform vec4 blurDist;
+uniform vec4 faceCm[3];
+uniform float faceOpacity, lumaComplement;
+uniform int fillEnabled;
+uniform float fillBlur, fillLighten, fillDarken, fillNormal;
+uniform float bleedAmount, bleedInvH, bleedBlur, bleedD0, bleedD1, bleedOpacity;
+uniform vec4 bleedCm[3];
+uniform vec2 bleedDarken;
+uniform float shadowAmount, shadowInvH, shadowDistOffset;
+uniform vec2 shadowOffset;
+uniform float shadowBlur, shadowInvRadius, shadowOpacity;
+uniform vec4 shadowCm[3];
+uniform float shadowContribution, shadowFaceOpacity;
+uniform vec2 ringOffset;
+uniform float ringStroke, ringRadius, ringOpacity, ringMask;
+uniform vec2 hlDir;
+uniform float hlHeight, hlSpread, hlAmount, hlOffset, hlBias;
+uniform int hlExtension, hlBiasCorrection, strokeMode;
+uniform float aberrAmount, aberrInvH, aberrOffset;
+uniform vec2 aberrDir;
+uniform float clampLimit;
+uniform int preserveHue;
+
+uniform int workLinear;
+uniform float workBlack;
+uniform float workWhite;
+uniform int sdrGamma22;
+
+in vec2 v_texcoord;
+layout(location = 0) out vec4 fragColor;
+
+vec3 fromSrgb(vec3 c) {
+    if (workLinear == 0) return c;
+    vec3 v = clamp(c, 0.0, 1.0);
+    vec3 l = sdrGamma22 == 1 ? pow(v, vec3(2.2)) : mix(pow((v + 0.055) / 1.055, vec3(2.4)), v / 12.92, lessThanEqual(v, vec3(0.04045)));
