+    // ========================================================================
+    // macOS 27 Liquid Glass (Spotlight family), fitted to captures of the real
+    // system at 3840x2160@1x. See MacGlassParams.hpp for the measured tables.
+    //
+    // Pipeline per fragment of the layer box:
+    //   outside the shape : drop shadow (two SDF Gaussians) + 1px dark outline
+    //   inside the shape  : edge refraction -> two-scale Gaussian blur (texSmall,
+    //                       tex) -> luma tone curve + chroma scale -> rim light
+    //   then the client's own surface (text, icons) is composited on top.
+    // All colour math happens on sRGB-encoded values, which is how macOS does it
+    // (fits in linear light were far worse). Linear FP16 work buffers (HDR) are
+    // decoded to sRGB first and re-encoded afterwards.
+    // ========================================================================
+    {"macglass.frag", R"GLSL(
+#version 300 es
+precision highp float;
+
+uniform sampler2D tex;       // wide blur, padded background sample
+uniform sampler2D texSmall;  // narrow blur, same layout
+uniform sampler2D maskTex;   // rendered layer surface, premultiplied, monitor sized
+uniform vec2 maskUVOffset;
+uniform vec2 maskUVScale;
+
+uniform vec2 fullSize;       // layer box in px
+uniform vec2 uvPadding;
+uniform vec2 glassBoxOffsetPx;
+uniform vec2 glassBoxSizePx;
+uniform float cornerRadius;  // px; >= half the short side gives a capsule
+uniform float capA;
+uniform float capN;
+uniform float pxScale;       // monitor scale: fitted lengths are px at 1x
+
+uniform float smallWeight;   // weight of texSmall in the blur mix
+uniform float lut[17];       // luma tone curve at g = 0,16,...,240,252
+uniform float chroma;
+
+uniform float refrA;
+uniform float refrW;
+uniform float refrP;
+
+uniform float rimR0;
+uniform float rimRC;
+uniform float rimA1;
+uniform float rimL1;
+uniform float rimL2;
+uniform float rimSide;
+uniform float rimK;
+
+uniform float outlineAlpha;
+uniform vec3 shadowKey;      // alpha, dy, sigma
+uniform vec3 shadowAmb;
+
+uniform float opacity;
+uniform int workLinear;      // 1: work buffer is linear (HDR / FP16)
+uniform float workBlack;     // work-buffer value of sRGB 0
+uniform float workWhite;     // work-buffer value of sRGB 1
+uniform int sdrGamma22;      // 1: SDR content is decoded with pure gamma 2.2
+
+in vec2 v_texcoord;
+layout(location = 0) out vec4 fragColor;
+
+float srgbEnc(float v) {
+    v = clamp(v, 0.0, 1.0);
+    if (sdrGamma22 == 1) return pow(v, 1.0 / 2.2);
+    return v <= 0.0031308 ? v * 12.92 : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
+}
+float srgbDec(float v) {
+    v = clamp(v, 0.0, 1.0);
+    if (sdrGamma22 == 1) return pow(v, 2.2);
+    return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
+}
+vec3 toSrgb(vec3 c) {
+    if (workLinear == 0) return c;
+    c = (c - workBlack) / max(workWhite - workBlack, 1e-6);
+    return vec3(srgbEnc(c.r), srgbEnc(c.g), srgbEnc(c.b));
+}
+vec3 fromSrgb(vec3 c) {
+    if (workLinear == 0) return c;
+    return vec3(srgbDec(c.r), srgbDec(c.g), srgbDec(c.b)) * (workWhite - workBlack) + workBlack;
+}
+
+// Continuous-curvature rounded box, fitted to the Spotlight capsule: each
+// corner is a superellipse with exponent capN reaching capA * r along the
+// long side. Returns an approximate signed distance in px (negative inside).
+float shapeLevel(vec2 q) {
+    vec2 S = glassBoxSizePx;
+    float r = min(cornerRadius, 0.5 * min(S.x, S.y));
+    float ex = min(capA * r, 0.5 * S.x);
+    float ey = min(capA * r, 0.5 * S.y);
+    vec2 c = clamp(q, vec2(ex, ey), S - vec2(ex, ey));
+    vec2 d = abs(q - c) / vec2(ex, ey);
+    float f = pow(pow(d.x, capN) + pow(d.y, capN), 1.0 / capN);
+    return (f - 1.0) * min(ex, ey);
+}
+
+// Standard normal CDF, tanh approximation (max error ~3e-4).
+float phi(float x) {
+    return 0.5 * (1.0 + tanh(0.7978845608 * (x + 0.044715 * x * x * x)));
+}
+
+float lutAt(float y) {
+    float g = clamp(y, 0.0, 1.0) * 255.0;
+    if (g < 240.0) {
+        float fi = floor(g / 16.0);
+        int i = int(fi);
+        return mix(lut[i], lut[i + 1], (g - fi * 16.0) / 16.0);
+    }
+    return mix(lut[15], lut[16], (g - 240.0) / 12.0);
+}
+
+vec3 sampleBlur(vec2 posPx) {
+    vec2 uv = posPx / fullSize;
+    vec2 tuv = clamp(uv * (1.0 - 2.0 * uvPadding) + uvPadding, 0.0005, 0.9995);
+    vec3 s = texture(texSmall, tuv).rgb;
+    vec3 b = texture(tex, tuv).rgb;
+    return toSrgb(mix(b, s, smallWeight));
+}
+
+void main() {
+    vec2 p = v_texcoord * fullSize;
+    vec2 q = p - glassBoxOffsetPx;
+    float lv = shapeLevel(q);
+
+    vec4 surf = texture(maskTex, clamp(v_texcoord * maskUVScale + maskUVOffset, 0.0, 1.0));
+
+    // coverage of {sdf < 0} and of the 1px outline band {0 < sdf < 1}
+    float covIn = clamp(0.5 - lv / pxScale, 0.0, 1.0);
+    float covOut = clamp(1.5 - lv / pxScale, 0.0, 1.0) - covIn;
+
+    // drop shadow (outside, under everything)
+    float sk = shadowKey.x * phi(-shapeLevel(q - vec2(0.0, shadowKey.y * pxScale)) / (shadowKey.z * pxScale));
+    float sa = shadowAmb.x * phi(-shapeLevel(q - vec2(0.0, shadowAmb.y * pxScale)) / (shadowAmb.z * pxScale));
+    float shadowA = 1.0 - (1.0 - sk) * (1.0 - sa);
+    float darkA = 1.0 - (1.0 - shadowA) * (1.0 - outlineAlpha * covOut);
+
+    vec3 glass = vec3(0.0);
+    if (covIn > 0.0) {
+        float depth = max(-lv, 0.0) / pxScale;
+        float e = 0.25;
+        vec2 grad = vec2(shapeLevel(q + vec2(e, 0.0)) - shapeLevel(q - vec2(e, 0.0)),
+                         shapeLevel(q + vec2(0.0, e)) - shapeLevel(q - vec2(0.0, e)));
+        vec2 n = grad / max(length(grad), 1e-6);
+
+        float u = clamp(depth / refrW, 0.0, 1.0);
+        float D = refrA * pow(1.0 - u, refrP) * pxScale;
+        vec3 b = sampleBlur(p - n * D);
+
+        float Y = dot(b, vec3(0.2126, 0.7152, 0.0722));
+        vec3 c = vec3(lutAt(Y)) + chroma * (b - Y);
+
+        float d0 = max(depth - 0.5, 0.0);
+        float prof = rimA1 * exp(-d0 / rimL1) + (1.0 - rimA1) * exp(-d0 / rimL2);
+        float ang = rimSide + (1.0 - rimSide) * pow(abs(n.y), rimK);
+        c += (vec3(rimRC) - c) * rimR0 * prof * ang;
+        glass = fromSrgb(clamp(c, 0.0, 1.0));
+    }
+
+    // premultiplied: glass (opaque, coverage covIn) over the dark shadow/outline
+    vec3 baseRGB = glass * covIn;
+    float baseA = covIn + (1.0 - covIn) * darkA;
+
+    // client surface on top
+    vec3 outRGB = surf.rgb + (1.0 - surf.a) * baseRGB;
+    float outA = surf.a + (1.0 - surf.a) * baseA;
+    fragColor = vec4(outRGB, outA) * opacity;
+}
+)GLSL"},
