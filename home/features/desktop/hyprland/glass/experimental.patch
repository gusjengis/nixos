+#pragma once
+
+// macOS 27 Liquid Glass, Spotlight family. Every number here was fitted to
+// screenshots of the real system (3840x2160 at 1x, dark appearance) across
+// the "Liquid Glass" transparency slider (NSGlassTintAmount 0..1). Lengths
+// are px at scale 1. Source data and fitting scripts live in
+// ~/Pictures/macos-reference/08-spotlight-glass on the capture machine.
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace MacGlass {
+
+// Continuous-capsule corner: superellipse exponent and long-side reach,
+// fitted to the 640x57 Spotlight field to 0.1 px rms.
+inline constexpr float CAP_N = 2.238f;
+inline constexpr float CAP_A = 30.94f / 28.5f;
+
+// Measured slider positions.
+inline constexpr std::array<float, 5> TINTS = {0.0f, 0.25f, 0.5f, 0.75f, 1.0f};
+
+// Luma tone curve, sRGB-encoded output for input luma g/255 at
+// g = 0,16,...,240,252, per slider position.
+inline constexpr std::array<std::array<float, 17>, 5> LUTS = {{
+    {0.1255f, 0.1725f, 0.2235f, 0.2745f, 0.3216f, 0.3686f, 0.4092f, 0.4471f, 0.4784f, 0.5059f, 0.5294f, 0.5490f, 0.5608f, 0.5725f, 0.5765f, 0.5765f, 0.5725f},
+    {0.1255f, 0.1725f, 0.2235f, 0.2745f, 0.3216f, 0.3647f, 0.4039f, 0.4392f, 0.4667f, 0.4902f, 0.5098f, 0.5255f, 0.5373f, 0.5412f, 0.5412f, 0.5373f, 0.5294f},
+    {0.1255f, 0.1725f, 0.2235f, 0.2706f, 0.3176f, 0.3569f, 0.3961f, 0.4275f, 0.4549f, 0.4745f, 0.4902f, 0.5007f, 0.5059f, 0.5033f, 0.4980f, 0.4902f, 0.4784f},
+    {0.1176f, 0.1529f, 0.1882f, 0.2235f, 0.2588f, 0.2902f, 0.3176f, 0.3412f, 0.3608f, 0.3765f, 0.3882f, 0.4000f, 0.4039f, 0.4039f, 0.4039f, 0.4000f, 0.3922f},
+    {0.1255f, 0.1529f, 0.1804f, 0.2039f, 0.2275f, 0.2471f, 0.2667f, 0.2824f, 0.2980f, 0.3098f, 0.3216f, 0.3281f, 0.3333f, 0.3373f, 0.3373f, 0.3373f, 0.3373f},
+}};
+
+// Chroma scale around luma: out = lut(Y) + chroma * (in - Y).
+inline constexpr std::array<float, 5> CHROMA = {1.1169f, 1.1043f, 1.0834f, 0.8719f, 0.6635f};
+
+// Two-scale Gaussian blur in sRGB-encoded space: (1-w2) G(s1) + w2 G(s2).
+// Fitted at slider 0, 0.5 and 1; 0.25 and 0.75 are interpolated.
+struct SBlur {
+    float s1, s2, w2;
+};
+inline constexpr std::array<SBlur, 3> BLUR_AT = {{
+    {4.6536f, 40.3273f, 0.2181f},
+    {7.4105f, 32.8449f, 0.3355f},
+    {10.5681f, 32.1030f, 0.5950f},
+}};
+
+// Edge refraction: samples are pulled inward by A * (1 - depth/W)^p.
+inline constexpr float REFR_A = 12.2734f;
+inline constexpr float REFR_W = 18.7632f;
+inline constexpr float REFR_P = 1.5954f;
+
+// Rim light: out += (RC - out) * R0 * prof(depth) * ang(normal).
+inline constexpr float RIM_R0   = 0.1805f;
+inline constexpr float RIM_RC   = 1.2820f;
+inline constexpr float RIM_A1   = 0.8408f;
+inline constexpr float RIM_L1   = 0.4956f;
+inline constexpr float RIM_L2   = 2.5775f;
+inline constexpr float RIM_SIDE = 0.1967f;
+inline constexpr float RIM_K    = 13.7343f;
+
+// 1 px dark outline just outside the glass, and the drop shadow (identical
+// at every slider position): alpha, y offset, sigma.
+inline constexpr float OUTLINE_ALPHA = 0.9677f;
+inline constexpr std::array<float, 3> SHADOW_KEY = {0.547f, 23.66f, 15.87f};
+inline constexpr std::array<float, 3> SHADOW_AMB = {0.135f, -4.72f, 11.79f};
+
+struct STintParams {
+    std::array<float, 17> lut;
+    float                 chroma;
+    SBlur                 blur;
+};
+
+inline STintParams paramsForTint(float tint) {
+    tint = std::clamp(std::isfinite(tint) ? tint : 1.0f, 0.0f, 1.0f);
+
+    size_t i = 0;
+    while (i + 2 < TINTS.size() && tint > TINTS[i + 1])
+        i++;
+    const float f = (tint - TINTS[i]) / (TINTS[i + 1] - TINTS[i]);
+
+    STintParams out{};
+    for (size_t k = 0; k < 17; k++)
+        out.lut[k] = LUTS[i][k] + (LUTS[i + 1][k] - LUTS[i][k]) * f;
+    out.chroma = CHROMA[i] + (CHROMA[i + 1] - CHROMA[i]) * f;
+
+    const float bt = tint * 2.0f;
+    const size_t b = std::min<size_t>(static_cast<size_t>(bt), 1);
+    const float  bf = bt - static_cast<float>(b);
+    out.blur = {BLUR_AT[b].s1 + (BLUR_AT[b + 1].s1 - BLUR_AT[b].s1) * bf,
+                BLUR_AT[b].s2 + (BLUR_AT[b + 1].s2 - BLUR_AT[b].s2) * bf,
+                BLUR_AT[b].w2 + (BLUR_AT[b + 1].w2 - BLUR_AT[b].w2) * bf};
+    return out;
+}
+
+} // namespace MacGlass
