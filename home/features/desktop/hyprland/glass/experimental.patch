+    // Exact separable Gaussian for the mac glass: support of 3 sigma, paired
+    // bilinear taps. Sigma in texels of the bound texture.
+    {"macblur.frag", R"GLSL(
+#version 300 es
+precision highp float;
+
+uniform sampler2D tex;
+uniform vec2 direction;
+uniform float sigma;
+
+in vec2 v_texcoord;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    if (sigma < 0.3) {
+        fragColor = texture(tex, v_texcoord);
+        return;
+    }
+    int radius = int(ceil(sigma * 3.0));
+    float k = -0.5 / (sigma * sigma);
+    vec4 acc = texture(tex, v_texcoord);
+    float wsum = 1.0;
+    for (int i = 1; i <= radius; i += 2) {
+        float x1 = float(i);
+        float x2 = float(i + 1);
+        float w1 = exp(x1 * x1 * k);
+        float w2 = (i + 1 <= radius) ? exp(x2 * x2 * k) : 0.0;
+        float w = w1 + w2;
+        float off = (x1 * w1 + x2 * w2) / w;
+        acc += (texture(tex, v_texcoord + direction * off) + texture(tex, v_texcoord - direction * off)) * w;
+        wsum += 2.0 * w;
+    }
+    fragColor = acc / wsum;
+}
 )GLSL"},
 
