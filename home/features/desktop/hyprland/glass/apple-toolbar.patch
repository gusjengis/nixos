+std::vector<SItemHints> ItemHints::regionsForSurface(CWLSurfaceResource* surface) {
+    std::vector<SItemHints> regions;
+    if (const auto primary = forSurface(surface))
+        regions.push_back(*primary);
+    auto* resource = g_api ? wireResource(surface) : nullptr;
+    hyprglass_item_state state{};
+    if (!resource || !g_api->get(resource, &state))
+        return regions;
+    for (uint32_t i = 0; i < HYPRGLASS_ITEM_HELPER_REGION_CAP; ++i) {
+        const auto& r = state.regions[i];
+        if (r.width <= 0.0 || r.height <= 0.0)
+            continue;
+        SItemHints hint;
+        hint.preset = r.preset;
+        hint.shapeMode = eItemShapeMode::EXPLICIT;
+        hint.x = r.x; hint.y = r.y; hint.width = r.width; hint.height = r.height;
+        hint.radii.fill(r.radius);
+        hint.slot = i + 1;
+        regions.push_back(std::move(hint));
+    }
+    return regions;
+}
