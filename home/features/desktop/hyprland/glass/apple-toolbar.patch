     clear_pending_shape(item);
 }
 
+static void item_handle_unset_region(struct wl_client* client, struct wl_resource* resource, uint32_t slot) {
+    (void)client;
+    struct item_object* item = wl_resource_get_user_data(resource);
+    if (!item->inert && slot < HYPRGLASS_ITEM_HELPER_REGION_CAP)
+        memset(&item->pending.regions[slot], 0, sizeof(item->pending.regions[slot]));
+}
+
+static void item_handle_set_region(struct wl_client* client, struct wl_resource* resource, uint32_t slot, const char* preset,
+                                   wl_fixed_t x, wl_fixed_t y, wl_fixed_t width, wl_fixed_t height, wl_fixed_t radius) {
+    struct item_object* item = wl_resource_get_user_data(resource);
+    if (item->inert || slot >= HYPRGLASS_ITEM_HELPER_REGION_CAP)
+        return;
+    item_handle_unset_region(client, resource, slot);
+    if (width <= 0 || height <= 0 || !preset || !preset[0])
+        return;
+    struct hyprglass_item_region* region = &item->pending.regions[slot];
+    strncpy(region->preset, preset, sizeof(region->preset) - 1);
+    region->x = wl_fixed_to_double(x);
+    region->y = wl_fixed_to_double(y);
+    region->width = wl_fixed_to_double(width);
+    region->height = wl_fixed_to_double(height);
+    region->radius = radius < 0 ? 0.0 : wl_fixed_to_double(radius);
+}
