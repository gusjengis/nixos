+// Measured Ref4K Dock label: circular 13 px caps, rounded shoulders and tip.
+// One signed-distance silhouette means no seam or differently tinted pointer.
+vec2 tooltipShoulder(float t) {
+    float u = 1.0 - t;
+    return u*u*u*vec2(15.0, 0.0) + 3.0*u*u*t*vec2(9.0, 0.0)
+         + 3.0*u*t*t*vec2(8.0, 2.0) + t*t*t*vec2(2.0, 6.0);
+}
+void tooltipEdge(vec2 p, vec2 a, vec2 b, inout float d2, inout float s) {
+    vec2 e = b - a;
+    vec2 v = p - a;
+    vec2 w = v - e * clamp(dot(v, e) / max(dot(e, e), 1e-8), 0.0, 1.0);
+    d2 = min(d2, dot(w, w));
+    bvec3 c = bvec3(p.y >= a.y, p.y < b.y, e.x*v.y > e.y*v.x);
+    if (all(c) || all(not(c))) s = -s;
+}
+float tooltipLevel(vec2 q) {
+    vec2 size = glassBoxSizePx / pxScale;
+    vec2 p = q / pxScale;
+    float h = size.y - 7.0;
+    float r = min(13.0, min(size.x, h) * 0.5);
+    vec2 d = abs(p - vec2(size.x, h)*0.5) - vec2(size.x, h)*0.5 + r;
+    float body = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
+    p -= vec2(size.x * 0.5, h);
+    float bodyDistance = abs(body);
+    // Remove the body's hidden bottom edge at the pointer attachment. A plain
+    // min(body, pointer) would leave an internal rim across the join.
+    if (p.y > -h * 0.5 && abs(p.x) < 15.0)
+        bodyDistance = min(length(vec2(15.0 - abs(p.x), p.y)), p.y + h);
+    float dist2 = 1e20;
+    float sign = 1.0;
+    vec2 a = tooltipShoulder(0.0);
+    // 8 chords per 7 px shoulder give subpixel contour accuracy at 1x/2x.
+    for (int i = 1; i <= 8; ++i) {
+        vec2 b = tooltipShoulder(float(i)/8.0);
+        tooltipEdge(p, a, b, dist2, sign);
+        a = b;
+    }
+    for (int i = 1; i <= 8; ++i) {
+        float t = float(i)/8.0;
+        vec2 b = vec2(2.0 - 4.0*t, 6.0 + 4.0*t*(1.0-t));
+        tooltipEdge(p, a, b, dist2, sign);
+        a = b;
+    }
+    for (int i = 7; i >= 0; --i) {
+        vec2 b = tooltipShoulder(float(i)/8.0) * vec2(-1.0, 1.0);
+        tooltipEdge(p, a, b, dist2, sign);
+        a = b;
+    }
+    // Close the polygon for the inside test only; its top is not an edge of
+    // the combined silhouette.
+    float ignored = 1e20;
+    tooltipEdge(p, a, tooltipShoulder(0.0), ignored, sign);
+    return (body < 0.0 || sign < 0.0 ? -1.0 : 1.0)
+         * min(bodyDistance, sqrt(dist2)) * pxScale;
+}
