+// macOS 27 Dock menu pointer, measured at 2x: half-profile in pt from the
+// shoulder on the body's bottom edge to the rounded tip, at 10 pt height.
+const vec2 CALLOUT[12] = vec2[12](vec2(17.0, 0.0), vec2(14.86, 0.25), vec2(12.0, 0.75), vec2(10.76, 1.25),
+                                  vec2(9.84, 1.75), vec2(9.29, 2.25), vec2(7.03, 4.75), vec2(4.56, 7.75),
+                                  vec2(3.61, 8.75), vec2(2.83, 9.25), vec2(1.73, 9.75), vec2(0.0, 10.0));
+
+// Body plus pointer as one silhouette. The body's bottom edge across the
+// pointer is interior, so neither rim nor depth shows a seam at the join.
+vec3 sdg(vec2 fp) {
+    if (callout.y <= 0.0)
+        return sdBody(fp, shapeRect);
+    vec4 rect = shapeRect;
+    rect.w -= callout.y * px;
+    vec3 body = sdBody(fp, rect);
+    float tipX = rect.x + (callout.x < 0.0 ? rect.z : 0.0) + callout.x * px;
+    vec2 p = vec2(fp.x - tipX, fp.y - rect.y - rect.w) / px;   // pt, +y below the body
+    float side = p.x < 0.0 ? -1.0 : 1.0;
+    vec2 ap = vec2(abs(p.x), p.y);
+    vec2 scale = vec2(1.0, callout.y / 10.0);
+    float d2 = 1e20;
+    float f = -1.0;
+    vec2 c = vec2(0.0);
+    vec2 a = CALLOUT[0] * scale;
+    for (int i = 1; i < 12; ++i) {
+        vec2 b = CALLOUT[i] * scale;
+        vec2 e = b - a;
+        vec2 q = a + e * clamp(dot(ap - a, e) / dot(e, e), 0.0, 1.0);
+        float l = dot(ap - q, ap - q);
+        if (l < d2) { d2 = l; c = q; }
+        if (ap.x <= a.x && ap.x >= b.x) f = mix(a.y, b.y, (a.x - ap.x) / max(a.x - b.x, 1e-6));
+        a = b;
+    }
+    float dp = sqrt(d2);
+    vec2 away = (ap - c) / max(dp, 1e-6) * vec2(side, 1.0);
+    bool inPointer = p.y >= 0.0 && p.y <= f;
+    if (body.x >= 0.0 && !inPointer)
+        return dp * px < body.x ? vec3(dp * px, away) : body;
+    if (body.x >= 0.0)
+        return vec3(-dp * px, -away);
+    float depth = -body.x / px;
+    vec2 n = body.yz;
+    if (ap.x < CALLOUT[0].x && n.y > 0.7) {
+        // Bottom edge was nearest: use the shoulders and the remaining edges.
+        vec2 toShoulder = vec2(side * CALLOUT[0].x - p.x, -p.y);
+        depth = length(toShoulder);
+        n = toShoulder / max(depth, 1e-6);
+        float top = p.y + rect.w / px;
+        float left = (fp.x - rect.x) / px;
+        float right = (rect.x + rect.z - fp.x) / px;
+        if (top < depth) { depth = top; n = vec2(0.0, -1.0); }
+        if (left < depth) { depth = left; n = vec2(-1.0, 0.0); }
+        if (right < depth) { depth = right; n = vec2(1.0, 0.0); }
+    }
+    return dp < depth ? vec3(-dp * px, -away) : vec3(-depth * px, n);
+}
