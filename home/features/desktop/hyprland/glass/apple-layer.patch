+            black  = (cm.srcTFRange.min - cm.dstTFRange.min) / range * cm.sdrBrightnessMultiplier;
+            white  = (cm.srcTFRange.max - cm.dstTFRange.min) / range * cm.sdrBrightnessMultiplier;
