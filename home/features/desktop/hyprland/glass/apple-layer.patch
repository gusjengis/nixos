+        for (int i = 0; i < std::min(mac.rectCount, MAX_MAC_RECTS); ++i) {
+            const auto& r = mac.rects[i];
+            const CBox  box{body.x + r.x * scale, body.y + r.y * scale, r.width * scale, r.height * scale};
+            if (box.x + box.w > body.x + body.w + 0.5 || box.y + box.h > body.y + body.h + 0.5)
+                continue;
+            shapes.emplace_back(box, r.radius * scale);
+        }
+    } else {
+        const float radius = mac.radius < 0.0f ? (body.h > 100.0f * scale ? 23.0f * scale : body.h * 0.5f) : mac.radius * scale;
+        shapes.emplace_back(body, radius);
+    }
