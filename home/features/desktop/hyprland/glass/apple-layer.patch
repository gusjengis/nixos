+            m_appleBgFramebuffer->alloc(static_cast<int>(target->m_size.x), static_cast<int>(target->m_size.y), target->m_drmFormat);
+        const auto bgFb = dynamic_cast<Render::GL::CGLFramebuffer*>(m_appleBgFramebuffer.get());
+        const int  x0 = std::max(0, static_cast<int>(std::floor(transformBox.x))), y0 = std::max(0, static_cast<int>(std::floor(transformBox.y)));
+        const int  x1 = std::min(static_cast<int>(target->m_size.x), static_cast<int>(std::ceil(transformBox.x + transformBox.w)));
+        const int  y1 = std::min(static_cast<int>(target->m_size.y), static_cast<int>(std::ceil(transformBox.y + transformBox.h)));
+        if (bgFb && x1 > x0 && y1 > y0) {
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, glTarget->getFBID());
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, bgFb->getFBID());
+            glBlitFramebuffer(x0, y0, x1, y1, x0, y0, x1, y1, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            glBindFramebuffer(GL_FRAMEBUFFER, glTarget->getFBID());
+        }
