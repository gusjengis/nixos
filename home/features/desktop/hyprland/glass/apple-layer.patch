+void CGlassLayerSurface::compositeApple(PHLMONITOR monitor, const SMacLayerShape& mac, float alpha, const CBox& rawBox, const CBox& transformBox,
+                                        const GlassRenderer::SMaskInfo& mask) {
+    const auto* preset = AppleGlass::preset(mac.apple);
