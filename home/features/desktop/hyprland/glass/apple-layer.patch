+    glActiveTexture(GL_TEXTURE0);
+    glUniform1i(loc("bgTex"), 1);
+    glUniform2f(loc("maskUVOffset"), mask.uvOffset.x, mask.uvOffset.y);
+    glUniform2f(loc("maskUVScale"), mask.uvScale.x, mask.uvScale.y);
+    glUniform1f(loc("opacity"), std::clamp(alpha, 0.0f, 1.0f));
+    glUniform1i(loc("placeholderAdditive"), additive ? 1 : 0);
+    {
+        const auto workDesc = g_pHyprRenderer->workBufferImageDescription();
+        const bool gamma22  = NColorManagement::getDefaultImageDescription()->value().transferFunction == NColorManagement::CM_TRANSFER_FUNCTION_GAMMA22;
+        bool       linear = false;
+        float      black = 0.0f, white = 1.0f;
+        if (workDesc->value().transferFunction == NColorManagement::CM_TRANSFER_FUNCTION_EXT_LINEAR) {
+            const auto cm = g_pHyprRenderer->getCMSettings(NColorManagement::getDefaultImageDescription(), workDesc, nullptr, true,
+                                                           monitor->m_sdrMinLuminance, monitor->m_sdrMaxLuminance);
