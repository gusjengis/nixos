+    if (m_appleStates.size() < shapes.size())
+        m_appleStates.resize(shapes.size());
+    const bool resample = layerSurface->mapped();
+    for (size_t i = 0; i < shapes.size(); ++i) {
+        if (!m_appleStates[i])
+            m_appleStates[i] = std::make_shared<AppleGlass::CState>();
+        const auto& [box, radius] = shapes[i];
+        m_appleStates[i]->draw(monitor, params, box, {radius, radius, radius, radius}, std::nullopt, 0.0f, alpha, resample);
+    }
+
+    // Client surface on top.
+    auto&      shaders = g_pGlobalState->shaderManager;
+    const auto glTarget = dynamic_cast<Render::GL::CGLFramebuffer*>(target.get());
