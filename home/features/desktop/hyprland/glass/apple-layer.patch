+        glUniform1f(loc("workBlack"), black);
+        glUniform1f(loc("workWhite"), white);
+        glUniform1i(loc("sdrGamma22"), gamma22 ? 1 : 0);
+    }
+    g_pHyprRenderer->blend(true);
+    glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
