+SParams paramsForTint(std::string_view name, float tint) {
+    const auto* base = preset(name);
+    if (!base)
+        return {};
+    SParams p = *base;
+    const float t = std::isfinite(tint) ? std::clamp(tint, 0.0f, 1.0f) : 1.0f;
+    const float low = std::min(2.0f * t, 1.0f);
+    const float high = std::max(2.0f * t - 1.0f, 0.0f);
+    if (name == "apple-dock" || name == "apple-widgets") {
+        p.blurRadius = name == "apple-dock" ? 1.2f * low : 0.2f + 0.2f * low;
+        // Enabling the fill at zero weight is equivalent to Apple's disabled path.
+        p.fillEnabled = true;
+        p.fillNormal = high;
+    } else if (name == "apple-menu") {
+        // Apple half-precision uniform rows at diffusion .5/.625/.75/.875/1.
+        // Below .5 these rows are constant; blur-fill and luma compression still vary.
+        static constexpr std::array<ColorMatrix, 5> rows = {{
+            {Row{1.23633f,-0.2146f,-0.02156f,0.125f}, Row{-0.06378f,1.08594f,-0.02168f,0.125f}, Row{-0.06384f,-0.21448f,1.27832f,0.125f}},
+            {Row{1.08203f,-0.18787f,-0.01888f,0.11328f}, Row{-0.05582f,0.94971f,-0.01898f,0.11328f}, Row{-0.05588f,-0.18762f,1.11816f,0.11328f}},
