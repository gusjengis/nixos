+    // Same shape rules as the fitted path (GlassRenderer::applyMacGlass), framebuffer px.
+    const float w = transformBox.w, h = transformBox.h;
+    const float inset = std::clamp(mac.inset * scale, 0.0f, std::min(w, h) * 0.5f - 1.0f);
