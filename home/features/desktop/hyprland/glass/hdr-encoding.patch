+vec4 sampleEncoded(vec2 uv) {
+    vec4 c = texture(tex, uv);
+    if (sourceLinear == 0) return c;
+    vec3 v = clamp((c.rgb - sourceBlack) / max(sourceWhite - sourceBlack, 1e-6), 0.0, 1.0);
+    if (sourceGamma22 == 1) {
+        c.rgb = pow(v, vec3(1.0 / 2.2));
+    } else {
+        c.rgb = mix(1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055,
+                    v * 12.92, lessThanEqual(v, vec3(0.0031308)));
+    }
+    return c;
+}
