@@ -1,8 +1,15 @@
 #include "theme/theme.hpp"
 #include "theme/colors.hpp"
 #include "theme/theme-db.hpp"
 #include "theme/theme-file.hpp"
+#include "ui/image/image-renderer.hpp"
+#include <QIcon>
+#include <QPixmapCache>
 
 void ThemeService::setTheme(const ThemeFile &info) {
+  // Icons may have changed on disk without changing the theme's name.
+  QIcon::setThemeSearchPaths(QIcon::themeSearchPaths());
+  QPixmapCache::clear();
+  ImageRendering::clearCache();
   m_theme = std::make_unique<ThemeFile>(info);
   emit themeChanged(info);
