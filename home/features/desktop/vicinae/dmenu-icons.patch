@@ -12,1 +12,48 @@
 #include <utility>
+#include <QDateTime>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QStandardPaths>
+#include <QTimer>
+
+void DMenuSection::startRemoteStatus() {
+  if (std::ranges::none_of(m_entries, [](auto entry) {
+        return entry.find("/windows-tile-pending.svg\t") != std::string_view::npos;
+      })) return;
+  // A tiny local snapshot supplies known status before the first frame.
+  refreshRemoteStatus();
+  auto *timer = new QTimer(&m_statusContext);
+  QObject::connect(timer, &QTimer::timeout, &m_statusContext, [this] { refreshRemoteStatus(); });
+  timer->start(500);
+}
+
+void DMenuSection::stopRemoteStatus() {
+  for (auto *timer : m_statusContext.findChildren<QTimer *>()) delete timer;
+}
+
+void DMenuSection::refreshRemoteStatus() {
+  std::unordered_map<std::size_t, bool> status;
+  QFile file(QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation) +
+             "/conference-remotes-status.json");
+  if (file.open(QIODevice::ReadOnly) && file.size() <= 65536) {
+    auto snapshot = QJsonDocument::fromJson(file.readAll()).object();
+    auto checked = snapshot.value("checked_at");
+    auto age = QDateTime::currentMSecsSinceEpoch() / 1000.0 - checked.toDouble();
+    // Expired or invalid data is unknown, never falsely online/offline.
+    if (checked.isDouble() && age >= 0 && age <= 20) {
+      auto hosts = snapshot.value("hosts").toObject();
+      for (auto [idx, entry] : vicinae::enumerate(m_entries)) {
+        auto third = entry.find_last_of('\t');
+        if (third == std::string_view::npos) continue;
+        auto address = entry.substr(third + 1);
+        auto online = hosts.value(QString::fromUtf8(address.data(), address.size()));
+        if (online.isBool()) status[idx] = online.toBool();
+      }
+    }
+  }
+  if (status != m_remoteStatus) {
+    m_remoteStatus = std::move(status);
+    notifyItemsRefreshed();
+  }
+}
