+    // Finder reserves the title before expanding search, then gives search
+    // three quarters of additional toolbar width, capped at 325 pt. Below
+    // 180 pt it collapses to a 36 pt magnifier rather than squeezing the text.
+    crate::ui::frame::after_layout(toolbar, move |toolbar| {
+        let (Some(slot), Some(search)) = (weak_slot.upgrade(), weak_search.upgrade()) else {
+            return;
+        };
+        let preferred = (f64::from(toolbar.width()) * 0.75 - 478.0).round() as i32;
+        let compact = preferred < 180;
+        let width = if compact { 36 } else { preferred.min(325) };
+        if let Some(label) = search.child().and_then(|content| content.last_child()) {
+            label.set_visible(!compact);
+        }
+        if compact {
+            search.add_css_class("compact");
+        } else {
+            search.remove_css_class("compact");
+        }
+        slot.set_preferred_width(width);
+    });
+}
