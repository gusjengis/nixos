diff --git a/src/ui/window/composition/search_slot.rs b/src/ui/window/composition/search_slot.rs
new file mode 100644
index 00000000..44c71980
--- /dev/null
+++ b/src/ui/window/composition/search_slot.rs
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+
+use gtk::{glib, prelude::*, subclass::prelude::*};
+
+mod imp {
+    use super::*;
+    use std::cell::Cell;
+
+    #[derive(Default)]
+    pub struct SearchSlot {
+        pub preferred: Cell<i32>,
+    }
+
+    #[glib::object_subclass]
+    impl ObjectSubclass for SearchSlot {
+        const NAME: &'static str = "StrataFinderSearchSlot";
+        type Type = super::SearchSlot;
+        type ParentType = gtk::Widget;
+    }
+
+    impl ObjectImpl for SearchSlot {
+        fn dispose(&self) {
+            if let Some(child) = self.obj().first_child() {
+                child.unparent();
+            }
+        }
+    }
+
+    impl WidgetImpl for SearchSlot {
+        fn measure(&self, orientation: gtk::Orientation, for_size: i32) -> (i32, i32, i32, i32) {
+            if orientation == gtk::Orientation::Horizontal {
+                // A preferred field width must never become the window's minimum.
+                let minimum = self
+                    .obj()
+                    .first_child()
+                    .map_or(36, |child| child.measure(orientation, for_size).0.max(36));
+                (minimum, self.preferred.get().max(minimum), -1, -1)
+            } else {
+                self.obj().first_child().map_or((36, 36, -1, -1), |child| {
+                    child.measure(orientation, for_size)
+                })
+            }
+        }
+
+        fn size_allocate(&self, width: i32, height: i32, baseline: i32) {
+            if let Some(child) = self.obj().first_child() {
+                child.allocate(width, height, baseline, None);
+            }
+        }
+
+        fn snapshot(&self, snapshot: &gtk::Snapshot) {
+            if let Some(child) = self.obj().first_child() {
+                self.obj().snapshot_child(&child, snapshot);
+            }
+        }
+    }
+}
+
+glib::wrapper! {
+    pub struct SearchSlot(ObjectSubclass<imp::SearchSlot>)
+        @extends gtk::Widget,
+        @implements gtk::Accessible, gtk::Buildable, gtk::ConstraintTarget;
+}
+
+impl SearchSlot {
+    pub(super) fn new(button: &gtk::Button) -> Self {
+        let slot: Self = glib::Object::new();
+        slot.set_valign(gtk::Align::Center);
+        button.set_parent(&slot);
+        slot.set_visible(button.get_visible());
+        let weak_slot = slot.downgrade();
+        button.connect_visible_notify(move |button| {
+            if let Some(slot) = weak_slot.upgrade() {
+                slot.set_visible(button.get_visible());
+            }
+        });
+        slot
+    }
+
+    pub(super) fn set_preferred_width(&self, width: i32) {
+        if self.imp().preferred.replace(width) != width {
+            self.queue_resize();
+        }
+    }
+}
