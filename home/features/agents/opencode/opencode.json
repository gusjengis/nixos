{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./claude-auth/opencode-claude-auth.js"
  ],
  "model": "openai/gpt-6.1-sol",
  "mcp": {
    "supernote": {
      "type": "local",
      "command": ["supernote-mirror-mcp"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "color": "secondary"
    },
    "plan": {
      "color": "warning"
    },
    "explore": {
      "color": "accent"
    },
    "general": {
      "color": "success"
    },
    "title": {
      "model": "openai/gpt-6-luna-fast"
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "external_directory": {
      "/**": "allow",
      "~/**": "allow"
    }
  },
  "provider": {
    "nvidia": {
      "name": "NVIDIA Free",
      "options": {
        "apiKey": "{file:~/.config/secrets/api_keys/nvidia}"
      },
      "whitelist": [
        "deepseek-ai/deepseek-v4.1-flash",
        "google/gemma-4-31b-it",
        "meta/llama-3.2-11b-vision-instruct",
        "meta/llama-3.2-90b-vision-instruct",
        "meta/muse-glimmer-30b",
        "mistralai/mistral-nemotron",
        "moonshotai/kimi-k3",
        "nvidia/cosmos-reason2-8b",
        "nvidia/llama-3.1-nemotron-70b-instruct",
        "nvidia/llama-3.1-nemotron-ultra-253b-v1",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "nvidia/nemotron-3-super-120b-a12b",
        "nvidia/nemotron-3-ultra-550b-a55b",
        "nvidia/nemotron-3.5-lightning-30b-a3b",
        "openai/gpt-oss-20b",
        "poolside/laguna-xs-2.1",
        "z-ai/glm-5.3",
        "z-ai/glm-5.3-flash"
      ],
      "models": {
        "deepseek-ai/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 262144
          }
        }
      }
    },
    "ollama-omega": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (omega)",
      "options": {
        "baseURL": "http://omega.tail29bd65.ts.net:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (omega)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "phi4-mini": {
          "name": "Phi4 Mini (omega)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4 26b"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next 6b"
        }
      }
    }
  }
}
