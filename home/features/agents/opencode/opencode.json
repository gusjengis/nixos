{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-claude-auth@1.5.4"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "external_directory": {
      "/**": "allow",
      "~/**": "allow"
    }
  },
  "provider": {
    "ollama-omega": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (omega)",
      "options": {
        "baseURL": "http://omega.tail29bd65.ts.net:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (omega)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "phi4-mini": {
          "name": "Phi4 Mini (omega)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4 26b"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next 6b"
        }
      }
    }
  }
}
