# Based on darwin-plymouth by Lozano Juan Pablo (GPL-3.0).
# https://github.com/libredeb/darwin-plymouth

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.original = ImageNew("logo.png");
logo.image = logo.original.Scale(480, 166);
logo.sprite = SpriteNew();
logo.sprite.SetImage(logo.image);
logo.sprite.SetPosition(Window.GetX() + (Window.GetWidth() - logo.image.GetWidth()) / 2,
                        Window.GetY() + Window.GetHeight() / 2 - 98, 1);

track.image = ImageNew("progress_box.png");
track.sprite = SpriteNew();
track.sprite.SetImage(track.image);
track.sprite.SetPosition(Window.GetX() + (Window.GetWidth() - track.image.GetWidth()) / 2,
                         Window.GetY() + Window.GetHeight() / 2 + 110 - track.image.GetHeight() / 2, 1);

fill.original = ImageNew("progress_bar.png");
fill.width = fill.original.GetWidth();
fill.height = fill.original.GetHeight();
fill.x = Window.GetX() + (Window.GetWidth() - fill.width) / 2;
fill.y = Window.GetY() + Window.GetHeight() / 2 + 110 - fill.height / 2;
fill.sprite = SpriteNew();
fill.sprite.SetPosition(fill.x, fill.y, 2);
fill.cap = SpriteNew();
fill.cap.SetImage(fill.original.Crop(fill.width - 6, 0, 6, fill.height));
fill.cap.SetOpacity(0);
fill.progress = 0;
session_ready = false;
blank_screen = Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot";
if (blank_screen) {
  logo.sprite.SetOpacity(0);
  track.sprite.SetOpacity(0);
  fill.sprite.SetOpacity(0);
}

fun progress_callback(duration, progress) {
  # Plymouth can report 100% at the initrd handoff, then resume from a lower value.
  if (session_ready)
    progress = 1;
  else if (progress >= 1)
    progress = fill.progress / fill.width;
  progress = Math.Max(0, Math.Min(1, progress));
  width = Math.Int(fill.width * progress);
  if (width > 0)
    width = Math.Max(12, width);
  if (!blank_screen && width > 0 && width != fill.progress) {
    fill.sprite.SetImage(fill.original.Crop(0, 0, width - 6, fill.height));
    fill.cap.SetPosition(fill.x + width - 6, fill.y, 2);
    fill.cap.SetOpacity(1);
    fill.progress = width;
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

fun message_callback(text) {
  if (text == "darwin-session-ready") {
    session_ready = true;
    progress_callback(0, 1);
  }
}
Plymouth.SetDisplayMessageFunction(message_callback);

prompt.sprite = SpriteNew();
prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() * 0.25,
                          Window.GetY() + Window.GetHeight() * 0.73, 3);
fun password_callback(text, bullets) {
  prompt.sprite.SetImage(Image.Text(text, 1, 1, 1));
  prompt.sprite.SetOpacity(1);
  fill.sprite.SetOpacity(0);
  fill.cap.SetOpacity(0);
  track.sprite.SetOpacity(0);
}
fun normal_callback() {
  prompt.sprite.SetOpacity(0);
  if (!blank_screen) {
    fill.sprite.SetOpacity(1);
    if (fill.progress > 0)
      fill.cap.SetOpacity(1);
    track.sprite.SetOpacity(1);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
