filters:
  and:
    - file.inFolder("Thoughts")
    - '!types.contains("meta")'
    - '!types.contains("noise")'
    - "orphaned != true"
views:
  - type: table
    name: Ranked
    filters:
      and:
        - 'file.hasProperty("score")'
        - 'status != "done"'
        - 'status != "dropped"'
        - 'status != "someday"'
        - 'status != "dealt-with"'
    order:
      - file.name
      - score
      - contexts
      - score-facet
      - status
      - score-parts
      - score-unsure
    sort:
      - property: score
        direction: DESC
  - type: table
    name: Open tasks
    filters:
      and:
        - 'types.contains("task") || types.contains("reminder")'
        - 'status != "done"'
        - 'status != "dropped"'
        - 'status != "someday"'
        - 'status != "dealt-with"'
    groupBy:
      property: note.tags
      direction: ASC
    order:
      - file.name
      - score
      - status
      - tags
      - captured
      - mentions_count
    sort:
      - property: score
        direction: DESC
      - property: captured
        direction: DESC
  - type: table
    name: Purchases
    filters:
      and:
        - 'types.contains("purchase")'
        - 'status != "done"'
        - 'status != "dropped"'
        - 'status != "dealt-with"'
    order:
      - file.name
      - status
      - tags
      - captured
  - type: table
    name: Open questions
    filters:
      and:
        - or:
            - 'types.contains("question")'
            - 'types.contains("decision")'
        - 'status != "dealt-with"'
    order:
      - file.name
      - types
      - tags
      - captured
    sort:
      - property: captured
        direction: DESC
  - type: table
    name: Projects
    filters:
      and:
        - 'types.contains("project")'
        - 'status != "dealt-with"'
    order:
      - file.name
      - tags
      - captured
  - type: table
    name: Ideas
    filters:
      and:
        - 'types.contains("idea")'
        - 'status != "dealt-with"'
    groupBy:
      property: note.tags
      direction: ASC
    order:
      - file.name
      - tags
      - mentions_count
      - captured
  - type: table
    name: Recurring
    filters:
      and:
        - "mentions_count > 1"
        - 'status != "dealt-with"'
    order:
      - file.name
      - types
      - mentions_count
      - captured
    sort:
      - property: mentions_count
        direction: DESC
  - type: table
    name: Recent
    order:
      - file.name
      - types
      - tags
      - captured
    sort:
      - property: captured
        direction: DESC
    limit: 100
