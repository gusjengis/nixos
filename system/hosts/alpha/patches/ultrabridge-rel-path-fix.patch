+// TestScan_ReconcilesStaleRelPath verifies that a rel_path value cached under
+// a previous notes_path root (e.g. before a source config change) is
+// self-healed on the next Scan(), even when the file's mtime hasn't changed —
+// without spuriously re-queueing the file for OCR reprocessing.
+func TestScan_ReconcilesStaleRelPath(t *testing.T) {
+	s := openTestStore(t)
+	noteFile := filepath.Join(s.notesPath, "sub", "test.note")
+	if err := os.MkdirAll(filepath.Dir(noteFile), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(noteFile, []byte("data"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(noteFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mtimeUnix := info.ModTime().Unix()
+	now := time.Now().UnixMilli()
+
+	// Seed a row with a stale rel_path, simulating one cached under an old
+	// notes_path root (mtime matches disk, so a naive mtime-only check would
+	// never notice or fix it).
+	if _, err := s.db.ExecContext(context.Background(), `
+		INSERT INTO notes (path, rel_path, file_type, size_bytes, mtime, created_at, updated_at)
+		VALUES (?, ?, 'note', ?, ?, ?, ?)`,
+		noteFile, "STALE/PREFIX/sub/test.note", info.Size(), mtimeUnix, now, now); err != nil {
+		t.Fatalf("seed stale row: %v", err)
+	}
+
+	changed, err := s.Scan(context.Background())
+	if err != nil {
+		t.Fatalf("Scan: %v", err)
+	}
+	if len(changed) != 0 {
+		t.Errorf("rel_path-only fix should not be reported as changed (would trigger needless OCR requeue), got %v", changed)
+	}
+
+	nf, err := s.Get(context.Background(), noteFile)
+	if err != nil {
+		t.Fatalf("Get after scan: %v", err)
+	}
+	wantRelPath := filepath.Join("sub", "test.note")
+	if nf.RelPath != wantRelPath {
+		t.Errorf("RelPath = %q, want %q (stale value should be reconciled)", nf.RelPath, wantRelPath)
+	}
+}
