+// TestRenameFile_RecomputesRelPath verifies that moving a note into a new
+// on-disk subfolder (e.g. the device reorganizing "AGC.note" into an "AGC/"
+// folder) updates rel_path to match the new location, instead of leaving the
+// old rel_path stale and hiding the file from both the old and new folder
+// views in the file browser.
+func TestRenameFile_RecomputesRelPath(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	now := time.Now().Unix()
+
+	oldPath := filepath.Join(s.notesPath, "AGC.note")
+	newPath := filepath.Join(s.notesPath, "AGC", "AGC.note")
+
+	if _, err := s.db.ExecContext(ctx, `
+		INSERT INTO notes (path, rel_path, file_type, size_bytes, mtime, created_at, updated_at)
+		VALUES (?, 'AGC.note', 'note', 0, ?, ?, ?)`, oldPath, now, now, now); err != nil {
+		t.Fatalf("seed notes: %v", err)
+	}
+
+	if err := s.RenameFile(ctx, oldPath, newPath); err != nil {
+		t.Fatalf("RenameFile: %v", err)
+	}
+
+	nf, err := s.Get(ctx, newPath)
+	if err != nil {
+		t.Fatalf("Get after rename: %v", err)
+	}
+	wantRelPath := filepath.Join("AGC", "AGC.note")
+	if nf.RelPath != wantRelPath {
+		t.Errorf("RelPath after rename = %q, want %q", nf.RelPath, wantRelPath)
+	}
+}
